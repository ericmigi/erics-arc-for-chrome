{
  "manifest_version": 3,
  "name": "Eric's Arc for Chrome",
  "version": "2.4",
  "description": "Arc features for Chrome's built-in tab bar.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "tabGroups", "storage", "webNavigation", "scripting", "search", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["little-click.js"], "all_frames": true, "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["little-open.js"], "all_frames": true, "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://open.spotify.com/*", "https://music.youtube.com/*", "https://soundcloud.com/*", "https://music.apple.com/*",
        "https://listen.tidal.com/*", "https://*.bandcamp.com/*", "https://www.pandora.com/*", "https://music.amazon.com/*",
        "https://www.deezer.com/*"],
      "js": ["music.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://open.spotify.com/*", "https://music.youtube.com/*", "https://soundcloud.com/*", "https://music.apple.com/*",
        "https://listen.tidal.com/*", "https://*.bandcamp.com/*", "https://www.pandora.com/*", "https://music.amazon.com/*",
        "https://www.deezer.com/*"],
      "js": ["music-relay.js"], "run_at": "document_start" }
  ],
  "action": { "default_title": "Reset pinned tab" },
  "commands": {
    "close-tab": {
      "suggested_key": { "mac": "Command+W", "default": "Ctrl+W" },
      "description": "Close tab (locked tabs come back at their locked URL)"
    },
    "reset-tab": {
      "suggested_key": { "mac": "MacCtrl+R", "default": "Alt+R" },
      "description": "Reset pinned tab to its pinned URL"
    },
    "repin-current": {
      "description": "Replace pinned URL with current"
    },
    "recent-next": {
      "suggested_key": { "mac": "MacCtrl+Period", "default": "Ctrl+Period" },
      "description": "Recently used tab: start (Karabiner sends this for the first Ctrl+Tab)"
    },
    "recent-continue": {
      "description": "Recently used tab: keep going (Karabiner sends Ctrl+Shift+Period for more Ctrl+Tabs)"
    },
    "recent-prev": {
      "suggested_key": { "mac": "MacCtrl+Comma", "default": "Ctrl+Comma" },
      "description": "Recently used tab: step back (Karabiner sends this for Ctrl+Shift+Tab)"
    },
    "little-new": {
      "description": "New Little Arc (set its scope to Global)"
    },
    "little-open": {
      "description": "Little Arc: open in Chrome"
    },
    "little-open-in": {
      "description": "Little Arc: open in window or tab group…"
    }
  }
}
